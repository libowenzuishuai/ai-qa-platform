# 生产环境变量样例：只放名字与说明，不携带任何真实凭据。
# 复制为 deploy/.env.production 并填入真实值（该文件不得提交）。

# —— 数据库 ——
POSTGRES_USER=            # 数据库用户名（例如 aiqa）
POSTGRES_PASSWORD=        # 数据库密码（强随机值，禁止示例值）
POSTGRES_DB=              # 数据库名（例如 aiqa）

# —— API ——
SESSION_SECRET=           # 会话签名密钥（强随机值）
SEED_ADMIN_USERNAME=      # 初始管理员用户名（首次启动创建）
SEED_ADMIN_PASSWORD=      # 初始管理员密码（强随机值，登录后应立即更换）

# —— 智能服务 ——
AIQA_INTELLIGENCE_TOKEN=  # Python 智能服务认证令牌（强随机值）
AIQA_TEXT_PROVIDER=       # 文本模型提供方（moonshot/mock）
AIQA_TEXT_BASE_URL=       # 文本模型 API 地址（留空用提供方默认）
AIQA_TEXT_MODEL=          # 文本模型名
AIQA_TEXT_API_KEY=        # 文本模型 API 密钥（走安全配置，不入库不入日志）
AIQA_VISION_PROVIDER=     # 视觉模型提供方
AIQA_VISION_BASE_URL=     # 视觉模型 API 地址
AIQA_VISION_MODEL=        # 视觉模型名
AIQA_VISION_API_KEY=      # 视觉模型 API 密钥
AIQA_INTELLIGENCE_TIMEOUT_MS=120000

# —— 发布端口/绑定（默认只绑本机；按需改为 0.0.0.0 或具体地址）——
API_BIND=127.0.0.1
API_PORT_PUBLISHED=7300
WORKER_BIND=127.0.0.1
WORKER_PORT_PUBLISHED=7200
WEB_BIND=127.0.0.1
WEB_PORT_PUBLISHED=7100

# —— demo profile（docker compose --profile demo 才启用）——
DEMO_BIND=127.0.0.1
DEMO_PORT_PUBLISHED=7400
DEMO_FIXTURE_TOKEN=       # demo 固件令牌（仅 demo profile 需要）
DEMO_BUG_MODES=           # 缺陷模式注入（逗号分隔，仅评测用）
