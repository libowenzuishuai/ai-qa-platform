{
  "name": "ai-qa-platform",
  "private": true,
  "version": "0.1.0",
  "description": "AI 质量验收平台：需求驱动的业务测试、工程检查与证据化发布评审",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:demo": "pnpm --filter @ai-qa/demo-app dev",
    "dev:api": "pnpm --filter @ai-qa/api dev",
    "dev:worker": "pnpm --filter @ai-qa/worker dev",
    "dev:web": "pnpm --filter @ai-qa/web dev",
    "build:apps": "pnpm --filter @ai-qa/demo-app --filter @ai-qa/worker --filter @ai-qa/web build",
    "test:phase1": "node tools/phase1-acceptance/run.mjs",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "test": "pnpm -r test",
    "test:contracts": "pnpm --filter @ai-qa/contracts test",
    "test:golden": "pnpm --filter @ai-qa/demo-app test:golden",
    "test:runtime": "pnpm --filter @ai-qa/test-runtime test",
    "test:doc-ingestion": "services/intelligence/.venv/bin/python -m pytest services/intelligence/tests/doc_ingestion",
    "db:migrate": "pnpm --filter @ai-qa/api db:migrate",
    "db:seed": "pnpm --filter @ai-qa/api db:seed",
    "typecheck": "pnpm -r typecheck",
    "contracts:export": "pnpm --filter @ai-qa/contracts export:intelligence",
    "contracts:check": "pnpm --filter @ai-qa/contracts check:intelligence",
    "dev:intelligence": "services/intelligence/.venv/bin/python -m uvicorn aiqa_intelligence.app:app --app-dir services/intelligence/src --host 127.0.0.1 --port 7500",
    "test:intelligence": "services/intelligence/.venv/bin/python -m pytest services/intelligence/tests",
    "contracts:python": "services/intelligence/.venv/bin/python services/intelligence/scripts/generate_models.py",
    "test:p0": "pnpm --filter @ai-qa/worker exec vitest run test/p0-acceptance.test.ts"
  }
}
