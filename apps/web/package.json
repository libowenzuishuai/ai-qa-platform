{
  "name": "@ai-qa/web",
  "version": "0.1.0",
  "private": true,
  "description": "最小运行页面（阶段 1）：登录、启动运行、进度、取消、报告与证据。SSR 仅调用平台 API。",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:dist": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/formbody": "^8.0.2",
    "fastify": "^5.2.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
