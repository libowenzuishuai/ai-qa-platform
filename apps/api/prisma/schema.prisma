// AI 测试人员平台数据模型（PRD §6 开发契约）。
// 约定：
// - 所有实体含 id/createdAt；可变实体含 updatedAt。
// - 项目实体强制 projectId；跨表引用在应用层校验同项目。
// - 版本表（*Version）只追加，不原地覆盖语义字段。
// - 删除采用归档；报告引用的版本不可物理删除（应用层保证）。

generator client {
  provider = "prisma-client-js"
  // 构建镜像（bookworm）与运行镜像（noble）的 openssl 检测结果可能不同：
  // 显式固定两类目标，避免运行时找不到 Query Engine。
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 用户与权限 ----------

model User {
  id           String              @id @default(cuid())
  username     String              @unique
  passwordHash String
  displayName  String
  // 平台角色：ADMIN / LEAD / VIEWER（与待测系统业务角色无关）
  platformRole String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sessions     Session[]
  memberships  ProjectMembership[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  changeReviews     ChangeReview[]
  snapshotChanges   SnapshotChange[]
  id                String              @id @default(cuid())
  name              String
  settings          Json                @default("{}")
  activeBaselineId  String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  memberships       ProjectMembership[]
  environments      Environment[]
  documents         Document[]
  rules             Rule[]
  testCases         TestCase[]
  clarifications    Clarification[]
  baselines         Baseline[]
  runs              Run[]
  defects           Defect[]
  modelInvocations  ModelInvocation[]
  artifacts         Artifact[]
  deploymentEvents  DeploymentEvent[]
  jobs              Job[]
  planProposals     PlanProposal[]
  contextSnapshots  ContextSnapshot[]
  missions          Mission[]
  apiTemplates      ApiTemplate[]
  executionRunners  ExecutionRunner[]
  codeChecks        CodeCheck[]
  loginPreparations LoginPreparation[]
  capabilities      CapabilityCatalog[]
  workflowTemplates WorkflowTemplate[]
  releaseDecisions  ReleaseDecision[]
  goalProposals     GoalProposal[]
  projectMemories   ProjectMemory[]
  diagnoses         DiagnosisEntry[]
  dataPlugins       DataPlugin[]
  dataResources     DataResource[]
  workflowRuns      WorkflowRun[]
}

model ProjectMembership {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  // 项目内角色：ADMIN / LEAD / VIEWER
  role      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// ---------- 环境接入 ----------

model Environment {
  id                String              @id @default(cuid())
  projectId         String
  name              String
  baseUrl           String
  allowedOrigins    String[]
  dependencyOrigins String[]            @default([])
  isProduction      Boolean             @default(false)
  // secretRef -> 加密存储键；不存明文凭据
  secretRefs        Json                @default("{}")
  buildMetadata     Json                @default("{}")
  runtime           Json                @default("{}")
  revision          Int                 @default(1)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs              Run[]
  planProposals     PlanProposal[]
  missions          Mission[]
  apiTemplates      ApiTemplate[]
  loginPreparations LoginPreparation[]
  capabilities      CapabilityCatalog[]
  workflowTemplates WorkflowTemplate[]
  releaseDecisions  ReleaseDecision[]
  goalProposals     GoalProposal[]
  projectMemories   ProjectMemory[]
  diagnoses         DiagnosisEntry[]

  @@unique([id, projectId])
  @@index([projectId])
}

// ---------- 资料与来源 ----------

model Document {
  id        String            @id @default(cuid())
  projectId String
  title     String
  createdAt DateTime          @default(now())
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  DocumentVersion[]

  @@index([projectId])
}

model DocumentVersion {
  id               String          @id @default(cuid())
  documentId       String
  version          Int
  checksum         String
  storageKey       String
  // MARKDOWN / TXT / DOCX / PDF_TEXT / PDF_SCANNED / PNG / JPEG
  format           String
  // PENDING / PARSING / PARSED / FAILED / NEEDS_OCR
  parseStatus      String
  parserVersion    String?
  fileSizeBytes    Int?
  bundleStorageKey String?
  bundleChecksum   String?
  parseWarnings    Json            @default("[]")
  mode             String          @default("unknown")
  coverageSummary  Json            @default("{}")
  createdAt        DateTime        @default(now())
  document         Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceSpans      SourceSpan[]
  contextSources   ContextSource[]

  @@unique([documentId, version])
}

model SourceSpan {
  id                String          @id @default(cuid())
  documentVersionId String
  // { kind: "markdown-line"|"markdown-heading"|"docx-paragraph"|"docx-cell"|"pdf-page"|"image-region", ... }
  locator           Json
  quotedText        String?
  imageRegion       Json?
  // GOOD / LOW / UNPARSED
  extractionQuality String          @default("GOOD")
  createdAt         DateTime        @default(now())
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([documentVersionId])
}

// ---------- 规则 ----------

model Rule {
  id               String        @id @default(cuid())
  projectId        String
  currentVersionId String?
  createdAt        DateTime      @default(now())
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions         RuleVersion[]

  @@index([projectId])
}

model RuleVersion {
  id                 String    @id @default(cuid())
  ruleId             String
  version            Int
  statement          String
  // EXPLICIT / INFERRED / UNKNOWN
  classification     String
  role               String?
  precondition       String?
  action             String
  condition          String?
  expectation        String
  forbiddenBehaviors Json      @default("[]")
  priority           String    @default("P1")
  businessFields     Json      @default("[]")
  // [{ documentVersionId, sourceSpanIds }]
  sources            Json      @default("[]")
  conflictsWith      Json      @default("[]")
  // DRAFT / NEEDS_REVIEW / APPROVED / REJECTED / SUPERSEDED
  reviewStatus       String    @default("DRAFT")
  supersedesId       String?
  // manual / model
  origin             String
  generationMode     String?
  promptVersion      String?
  reviewedBy         String?
  reviewedAt         DateTime?
  /**
   * 批准即永久冻结：只能置位不能清除；冻结后语义字段不可改（评审 F1）。
   */
  semanticFrozen     Boolean   @default(false)
  createdAt          DateTime  @default(now())
  rule               Rule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
  @@index([reviewStatus])
}

model Clarification {
  id             String    @id @default(cuid())
  projectId      String
  ruleVersionIds String[]
  /**
   * MISSING_INFO / CONFLICT / AMBIGUITY（阶段 2 契约 ClarificationDraft.kind）。
   */
  kind           String    @default("MISSING_INFO")
  question       String
  answer         String?
  answerSource   String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ---------- 用例与计划 ----------

model TestCase {
  id               String            @id @default(cuid())
  projectId        String
  currentVersionId String?
  createdAt        DateTime          @default(now())
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions         TestCaseVersion[]

  @@unique([id, projectId])
  @@index([projectId])
}

model TestCaseVersion {
  id             String            @id @default(cuid())
  caseId         String
  version        Int
  title          String
  description    String?
  ruleVersionIds String[]
  roles          String[]
  preconditions  Json              @default("[]")
  dataSpec       Json
  steps          Json
  assertions     Json
  cleanup        Json
  priority       String            @default("P1")
  approvalStatus String            @default("DRAFT")
  supersedesId   String?
  origin         String
  generationMode String?
  promptVersion  String?
  approvalHash   String?
  // 反规范化 projectId：支持 attempt 的同项目复合外键（评审 R6）
  projectId      String
  /**
   * 批准即永久冻结：只能置位不能清除；冻结后语义字段不可改（评审 F1）。
   */
  semanticFrozen Boolean           @default(false)
  createdAt      DateTime          @default(now())
  // F4：与父 TestCase 的同项目复合外键，projectId 不能与父用例不一致
  testCase       TestCase          @relation(fields: [caseId, projectId], references: [id, projectId], onDelete: Cascade)
  plans          TestPlanVersion[]
  attempts       CaseAttempt[]
  proposals      PlanProposal[]

  @@unique([caseId, version])
  @@unique([id, projectId])
}

model TestPlanVersion {
  id                  String          @id @default(cuid())
  caseVersionId       String
  version             Int
  schemaVersion       String
  plan                Json
  environmentId       String?
  environmentRevision Int?
  bindingEvidenceIds  String[]        @default([])
  acceptanceHash      String
  createdAt           DateTime        @default(now())
  caseVersion         TestCaseVersion @relation(fields: [caseVersionId], references: [id], onDelete: Cascade)

  @@unique([caseVersionId, version])
}

model Baseline {
  id             String    @id @default(cuid())
  projectId      String
  name           String
  ruleVersionIds String[]
  caseVersionIds String[]
  scope          Json      @default("{}")
  exclusions     Json      @default("[]")
  createdAt      DateTime  @default(now())
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs           Run[]
  missions       Mission[]

  @@unique([id, projectId])
  @@index([projectId])
}

// ---------- 运行与执行 ----------

model Run {
  id                     String        @id @default(cuid())
  projectId              String
  baselineId             String
  environmentId          String
  buildId                String?
  // real / mock
  mode                   String
  lifecycle              String        @default("QUEUED")
  selectedCaseVersionIds String[]
  budget                 Json
  idempotencyKey         String
  // PENDING / PASS / FAIL / INCOMPLETE
  acceptanceStatus       String        @default("PENDING")
  /**
   * 运行事件序号分配器（R7）：所有事件生产者通过
   * UPDATE "eventSeq" = "eventSeq" + 1 RETURNING 原子取号。
   */
  eventSeq               Int           @default(0)
  /**
   * 用例计划版本固定（R3）：创建运行时固定每个用例执行的
   * planVersionId 与 acceptanceHash；worker 只按固定版本执行。
   * [{ caseVersionId, planVersionId, acceptanceHash }]
   */
  casePlanPins           Json          @default("[]")
  environmentSnapshot    Json          @default("{}")
  buildVerification      Json          @default("{}")
  modelConfigSnapshot    Json          @default("{}")
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  project                Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baseline               Baseline      @relation(fields: [baselineId, projectId], references: [id, projectId], onDelete: Restrict)
  environment            Environment   @relation(fields: [environmentId, projectId], references: [id, projectId], onDelete: Restrict)
  attempts               CaseAttempt[]
  events                 RunEvent[]
  missionRun             MissionRun?

  @@unique([projectId, idempotencyKey])
  @@unique([id, projectId])
  @@index([projectId])
}

/**
 * 持久化运行事件：SSE 的唯一事实来源（支持 Last-Event-ID 重放）。
 */
model RunEvent {
  id        String   @id @default(cuid())
  runId     String
  /**
   * run 内单调递增序号；重连按 seq 去重补发。
   */
  seq       Int
  type      String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, createdAt])
}

model CaseAttempt {
  id            String                  @id @default(cuid())
  runId         String
  caseVersionId String
  attemptNo     Int
  namespace     String
  lifecycle     String                  @default("QUEUED")
  // PASS / FAIL / BLOCKED / REVIEW / NOT_RUN
  verdict       String                  @default("NOT_RUN")
  reasonCode    String                  @default("NONE")
  unstable      Boolean                 @default(false)
  retryReason   String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime                @default(now())
  // 反规范化 projectId：同项目复合外键（评审 R6 —— 跨项目引用在数据库层拒绝）
  projectId     String
  run           Run                     @relation(fields: [runId, projectId], references: [id, projectId], onDelete: Cascade)
  caseVersion   TestCaseVersion         @relation(fields: [caseVersionId, projectId], references: [id, projectId], onDelete: Restrict)
  steps         StepExecution[]
  assertions    AssertionResultRecord[]

  @@unique([runId, caseVersionId, attemptNo])
}

model StepExecution {
  id          String      @id @default(cuid())
  attemptId   String
  stepId      String
  // PENDING / RUNNING / PASSED / FAILED / SKIPPED / BLOCKED / CANCELLED
  status      String      @default("PENDING")
  startedAt   DateTime?
  finishedAt  DateTime?
  actual      String?
  error       String?
  evidenceIds String[]    @default([])
  createdAt   DateTime    @default(now())
  attempt     CaseAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model AssertionResultRecord {
  id          String      @id @default(cuid())
  attemptId   String
  assertionId String
  expected    String?
  actual      String?
  unit        String?
  // PASS / FAIL / REVIEW / NOT_EVALUATED
  result      String      @default("NOT_EVALUATED")
  evaluatedAt DateTime?
  evidenceIds String[]    @default([])
  note        String?
  createdAt   DateTime    @default(now())
  attempt     CaseAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

// ---------- 证据 ----------

model Artifact {
  id          String    @id @default(cuid())
  projectId   String
  attemptId   String?
  storageKey  String
  // SCREENSHOT / TRACE / CONSOLE / NETWORK / FILE / DOM_SNAPSHOT / MODEL_OUTPUT
  type        String
  // NORMAL / RESTRICTED_RAW
  sensitivity String    @default("NORMAL")
  checksum    String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ---------- 缺陷 ----------

model Defect {
  id                  String             @id @default(cuid())
  projectId           String
  fingerprint         String
  sourceRuleVersionId String?
  assertionId         String?
  // CANDIDATE / CONFIRMED / FIX_PENDING / READY_FOR_RETEST / VERIFIED / REJECTED / REOPENED
  status              String             @default("CANDIDATE")
  assignedTo          String?
  severity            String             @default("P2")
  title               String
  description         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  occurrences         DefectOccurrence[]

  @@unique([projectId, fingerprint])
}

model DefectOccurrence {
  id           String   @id @default(cuid())
  defectId     String
  runId        String
  attemptId    String?
  evidenceRefs Json     @default("[]")
  buildId      String?
  createdAt    DateTime @default(now())
  defect       Defect   @relation(fields: [defectId], references: [id], onDelete: Cascade)

  @@unique([defectId, runId, attemptId])
  @@index([defectId])
}

// ---------- 模型用量与审计 ----------

model ModelInvocation {
  id            String   @id @default(cuid())
  projectId     String
  runId         String?
  provider      String
  model         String
  promptVersion String?
  requestId     String?
  usage         Json     @default("{}")
  estimatedCost Json?
  latencyMs     Int?
  outcome       String
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  beforeRef  String?
  afterRef   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------- 部署事件（webhook 去重） ----------

model DeploymentEvent {
  id         String   @id @default(cuid())
  projectId  String
  eventId    String
  payload    Json
  receivedAt DateTime @default(now())
  runId      String?
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, eventId])
}

/**
 * 阶段 2 异步作业（contracts/jobs.ts 的持久化宿主）。
 * 幂等（裁决点 4）：(projectId, kind, fingerprint) 唯一；同参数重复 POST 返回原 jobId。
 */
model Job {
  changeReview ChangeReview?
  snapshotChange SnapshotChange?
  id           String        @id @default(cuid())
  projectId    String
  kind         String
  status       String        @default("QUEUED")
  request      Json
  result       Json?
  error        Json?
  fingerprint  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, fingerprint])
  @@index([projectId, createdAt])
}

model PlanProposal {
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  caseVersion         TestCaseVersion @relation(fields: [caseVersionId], references: [id], onDelete: Restrict)
  environment         Environment     @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  id                  String          @id @default(cuid())
  projectId           String
  caseVersionId       String
  environmentId       String
  environmentRevision Int
  plan                Json
  mode                String
  createdAt           DateTime        @default(now())

  @@index([projectId])
}

model ContextSnapshot {
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sources       ContextSource[]
  missions      Mission[]
  id            String          @id @default(cuid())
  projectId     String
  repositoryUrl String
  commitSha     String
  subdirectory  String
  files         Json
  skipped       Json
  previousId    String?
  createdAt     DateTime        @default(now())

  @@index([projectId])
}

model ContextSource {
  snapshot          ContextSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  id                String          @id @default(cuid())
  snapshotId        String
  path              String
  documentVersionId String
  authority         String
  confirmedBy       String
  createdAt         DateTime        @default(now())

  @@unique([snapshotId, path])
}

model Mission {
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  baseline          Baseline         @relation(fields: [baselineId], references: [id], onDelete: Restrict)
  environment       Environment      @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  contextSnapshot   ContextSnapshot? @relation(fields: [contextSnapshotId], references: [id], onDelete: Restrict)
  runs              MissionRun[]
  workflows         WorkflowRun[]
  id                String           @id @default(cuid())
  projectId         String
  title             String
  goal              String
  template          String
  baselineId        String
  environmentId     String
  contextSnapshotId String?
  exclusions        Json             @default("[]")
  createdBy         String
  createdAt         DateTime         @default(now())

  @@index([projectId])
}

model MissionRun {
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Restrict)
  run       Run      @relation(fields: [runId], references: [id], onDelete: Restrict)
  id        String   @id @default(cuid())
  missionId String
  runId     String   @unique
  retestOf  String?
  createdAt DateTime @default(now())

  @@index([missionId])
}

model ApiTemplate {
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  id            String      @id @default(cuid())
  projectId     String
  environmentId String
  request       Json
  createdBy     String
  createdAt     DateTime    @default(now())

  @@index([projectId])
}

model ExecutionRunner {
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  checks       CodeCheck[]
  id           String      @id @default(cuid())
  projectId    String
  name         String
  tokenHash    String      @unique
  capabilities String[]
  revokedAt    DateTime?
  createdAt    DateTime    @default(now())

  @@index([projectId])
}

model CodeCheck {
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  runner         ExecutionRunner? @relation(fields: [runnerId], references: [id], onDelete: Restrict)
  id             String           @id @default(cuid())
  projectId      String
  request        Json
  status         String           @default("QUEUED")
  verdict        String           @default("INCOMPLETE")
  runnerId       String?
  leaseToken     String?
  leaseExpiresAt DateTime?
  deadlineAt     DateTime?
  result         Json?
  evidenceId     String?
  createdBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([projectId, status])
}

// ============ P0-1: 账号与准备中心 ============

model LoginPreparation {
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment      Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  id               String      @id @default(cuid())
  projectId        String
  environmentId    String
  role             String
  /**
   * secretRefs 中的角色 key，如 "applicant"。
   */
  credentialRef    String
  configuration    Json?
  lastCheckJobId   String?
  /**
   * 登录步骤：[{type:"fill",locator,value:{source:"credential",ref:"applicant.username"}}]
   */
  steps            Json
  /**
   * 登录成功标识：{locator, expectedText?}
   */
  successIndicator Json
  /**
   * 配置 sha256，变更后上次检查即失效。
   */
  configHash       String
  /**
   * 最近一次检查结果。
   */
  lastCheckStatus  String      @default("NEVER_CHECKED")
  lastCheckDetail  String?
  lastCheckAt      DateTime?
  lastCheckEnvRev  Int?
  /**
   * 检查有效期（小时），过期不能作为准备证明。
   */
  validityHours    Int         @default(24)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([projectId, environmentId, role])
  @@index([projectId])
}

// ============ P0-2: 数据准备与清理插件 ============

model DataPlugin {
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id                  String   @id @default(cuid())
  projectId           String
  /**
   * 插件类型标识，首版只有 "http-request"。
   */
  kind                String
  environmentId       String?
  environmentRevision Int?
  definition          Json?
  environmentSnapshot Json?
  version             Int      @default(1)
  /**
   * 参数 JSON Schema（前端据此生成表单）。
   */
  paramSchema         Json
  /**
   * 支持的效果类型。
   */
  effectTypes         String[]
  name                String
  enabled             Boolean  @default(true)
  createdBy           String
  createdAt           DateTime @default(now())

  @@unique([projectId, kind, version])
  @@index([projectId])
}

model DataResource {
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id                String   @id @default(cuid())
  projectId         String
  runId             String?
  attemptId         String?
  namespace         String
  /**
   * 插件引用。
   */
  pluginId          String
  /**
   * 外部资源标识（如 HTTP URL+method 或返回的业务 ID）。
   */
  externalRef       String
  /**
   * prepare|cleanup。
   */
  action            String
  /**
   * 动作参数指纹（幂等判定）。
   */
  actionFingerprint String
  parameters        Json     @default("{}")
  /**
   * pending|success|failed|unknown|cleaned|cleanup_failed。
   */
  status            String   @default("pending")
  evidenceId        String?
  detail            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([namespace, externalRef, action, actionFingerprint])
  @@unique([projectId, pluginId, namespace, action])
  @@index([projectId, runId])
  @@index([namespace])
}

// ============ P0-3: 持久化任务编排 ============

model WorkflowRun {
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mission           Mission?       @relation(fields: [missionId], references: [id], onDelete: SetNull)
  nodes             WorkflowNode[]
  id                String         @id @default(cuid())
  projectId         String
  missionId         String?
  /**
   * 模板版本。
   */
  templateVersion   String
  /**
   * 固定输入引用（documentVersionIds / baselineId / environmentId / buildId）。
   */
  inputs            Json
  status            String         @default("QUEUED")
  /**
   * {maxWallClockMs, maxModelCalls, maxToolCalls, maxTokens, estimatedCost}
   */
  budget            Json
  /**
   * 真实用量。
   */
  usage             Json           @default("{}")
  currentGate       String?
  eventSeq          Int            @default(0)
  idempotencyKey    String?
  inputFingerprint  String?
  cancelRequestedAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([projectId, idempotencyKey])
  @@index([projectId])
}

model WorkflowNode {
  workflow       WorkflowRun @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  id             String      @id @default(cuid())
  workflowId     String
  /**
   * 模板中的节点 key。
   */
  nodeKey        String
  /**
   * 检查点/依赖顺序。
   */
  seq            Int
  /**
   * queued|running|waiting_human|completed|failed|skipped。
   */
  status         String      @default("queued")
  /**
   * 节点幂等键。
   */
  idempotencyKey String
  /**
   * 输入内容 hash。
   */
  inputHash      String
  /**
   * 输出引用（JobId / RunId / 资产 ID 列表）。
   */
  outputRef      Json?
  /**
   * 人工待办描述。
   */
  humanTodo      Json?
  error          String?
  /**
   * 动作账本。
   */
  toolCalls      Json        @default("[]")
  leaseToken     String?
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([workflowId, nodeKey, idempotencyKey])
  @@unique([workflowId, nodeKey])
  @@index([workflowId, status])
}

model WorkflowEvent {
  id         String   @id @default(cuid())
  workflowId String
  seq        Int
  type       String
  payload    Json
  createdAt  DateTime @default(now())

  @@unique([workflowId, seq])
  @@index([workflowId, seq])
}

// Immutable inputs/results; resolutions are separately audited human decisions.
model ChangeReview {
  id                   String   @id @default(cuid())
  projectId            String
  jobId                String   @unique
  baselineId           String
  oldDocumentVersionId String
  newDocumentVersionId String
  input                Json
  inputHash            String
  output               Json?
  outputHash           String?
  resolutions          Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  job                  Job      @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

// ============ R02: 快照对比（多文件变更闭环） ============

model SnapshotChange {
  id            String   @id @default(cuid())
  projectId     String
  jobId         String   @unique
  baselineId    String
  /** 冻结的文件清单 [{documentVersionId, path}]（旧/新）。 */
  oldFiles      Json
  newFiles      Json
  excludedPaths Json     @default("[]")
  /** 冻结的 MultiFileComparisonInput（含全部 bundle）。 */
  input         Json
  inputHash     String
  /** MultiFileChangeReport（确定性输出）。 */
  output        Json?
  outputHash    String?
  resolutions   Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

// ============ R00: 能力目录 / 发布决策 / 目标规划 / 记忆 / 诊断 ============

model CapabilityCatalog {
  project               Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id                    String       @id @default(cuid())
  projectId             String
  key                   String
  version               Int
  name                  String
  description           String?
  inputSchema           Json
  outputSchema          Json
  effects               String[]
  requiredRoles         String[]
  requiresEnvironment   Boolean      @default(false)
  budgetCategory        String       @default("none")
  idempotencyStrategy   String       @default("read_only")
  recoveryStrategy      String       @default("read_only")
  cleanupResponsibility String?
  enabled               Boolean      @default(true)
  createdBy             String
  createdAt             DateTime     @default(now())
  environment           Environment? @relation(fields: [environmentId], references: [id])
  environmentId         String?

  @@unique([projectId, key, version])
  @@index([projectId])
}

model WorkflowTemplate {
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id                 String       @id @default(cuid())
  projectId          String
  key                String
  version            Int
  name               String
  description        String?
  nodes              Json
  defaultBudget      Json
  defaultParallelism Int          @default(1)
  status             String       @default("DRAFT")
  createdBy          String
  createdAt          DateTime     @default(now())
  publishedAt        DateTime?
  environment        Environment? @relation(fields: [environmentId], references: [id])
  environmentId      String?

  @@unique([projectId, key, version])
  @@index([projectId])
}

model ReleaseDecision {
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id               String       @id @default(cuid())
  projectId        String
  runIds           String[]
  decision         String
  decidedBy        String
  reason           String
  scope            String?
  evidenceSnapshot Json         @default("{}")
  decidedAt        DateTime     @default(now())
  environment      Environment? @relation(fields: [environmentId], references: [id])
  environmentId    String?

  @@index([projectId])
}

model GoalProposal {
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id              String       @id @default(cuid())
  projectId       String
  goal            String
  suggestedTools  Json         @default("[]")
  suggestedScope  Json         @default("{}")
  suggestedBudget Json         @default("{}")
  blockers        Json         @default("[]")
  status          String       @default("DRAFT")
  createdBy       String
  createdAt       DateTime     @default(now())
  reviewedBy      String?
  reviewedAt      DateTime?
  environment     Environment? @relation(fields: [environmentId], references: [id])
  environmentId   String?

  @@index([projectId])
}

model ProjectMemory {
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id                   String       @id @default(cuid())
  projectId            String
  content              String
  source               Json
  context              Json         @default("{}")
  validUntil           DateTime?
  invalidationTriggers Json         @default("[]")
  invalidated          Boolean      @default(false)
  invalidatedReason    String?
  createdAt            DateTime     @default(now())
  environment          Environment? @relation(fields: [environmentId], references: [id])
  environmentId        String?

  @@index([projectId])
}

model DiagnosisEntry {
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id            String       @id @default(cuid())
  projectId     String
  runId         String?
  attemptId     String?
  category      String
  facts         Json
  hypotheses    Json         @default("[]")
  suggestions   Json         @default("[]")
  confidence    String
  createdBy     String
  createdAt     DateTime     @default(now())
  environment   Environment? @relation(fields: [environmentId], references: [id])
  environmentId String?

  @@index([projectId])
}
