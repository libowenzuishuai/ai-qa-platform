{
  "name": "@ai-qa/api",
  "version": "0.1.0",
  "private": true,
  "description": "\u5e73\u53f0 API\uff1a\u9274\u6743\u3001\u9879\u76ee\u3001\u73af\u5883\u3001\u7528\u4f8b\u3001\u62a5\u544a\u63a5\u53e3\uff08\u9636\u6bb5 0\uff1a\u767b\u5f55 + \u9879\u76ee\u6743\u9650\u57fa\u7840\uff09",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start:dist": "node dist/server.js"
  },
  "dependencies": {
    "@ai-qa/artifact-store": "workspace:*",
    "@ai-qa/contracts": "workspace:*",
    "@ai-qa/evaluation": "workspace:*",
    "@ai-qa/model-adapters": "workspace:*",
    "@ai-qa/reporting": "workspace:*",
    "@ai-qa/run-events": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/formbody": "^8.0.2",
    "@prisma/client": "^6.3.0",
    "ajv": "8.20.0",
    "bullmq": "^5.34.0",
    "fastify": "^5.2.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.0",
    "zod": "^3.25.0",
    "@ai-qa/adapter-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
