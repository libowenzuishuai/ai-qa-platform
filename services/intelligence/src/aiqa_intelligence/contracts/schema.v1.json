{
  "$ref": "#/definitions/IntelligenceContracts",
  "definitions": {
    "ParsedDocumentBundle": {
      "type": "object",
      "properties": {
        "documentVersionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "format": {
          "type": "string",
          "enum": [
            "MARKDOWN",
            "TXT",
            "DOCX",
            "PDF_TEXT",
            "PDF_SCANNED",
            "PNG",
            "JPEG"
          ]
        },
        "parseStatus": {
          "type": "string",
          "enum": [
            "PENDING",
            "PARSING",
            "PARSED",
            "FAILED",
            "NEEDS_OCR"
          ]
        },
        "parserVersion": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/ParsedDocumentBundle/properties/documentVersionId"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "heading",
                  "paragraph",
                  "table",
                  "listItem",
                  "image"
                ]
              },
              "text": {
                "type": "string"
              },
              "page": {
                "type": "integer"
              },
              "imageStorageKey": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "spans": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/ParsedDocumentBundle/properties/documentVersionId"
              },
              "documentVersionId": {
                "$ref": "#/definitions/ParsedDocumentBundle/properties/documentVersionId"
              },
              "locator": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "markdown-line"
                      },
                      "startLine": {
                        "type": "integer"
                      },
                      "endLine": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "kind",
                      "startLine",
                      "endLine"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "markdown-heading"
                      },
                      "path": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "kind",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "docx-paragraph"
                      },
                      "paragraphIndex": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "kind",
                      "paragraphIndex"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "docx-cell"
                      },
                      "tableIndex": {
                        "type": "integer"
                      },
                      "row": {
                        "type": "integer"
                      },
                      "col": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "kind",
                      "tableIndex",
                      "row",
                      "col"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "pdf-page"
                      },
                      "page": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "kind",
                      "page"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "image-region"
                      },
                      "bbox": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 4,
                        "maxItems": 4
                      }
                    },
                    "required": [
                      "kind",
                      "bbox"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "quotedText": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "extractionQuality": {
                "type": "string",
                "enum": [
                  "GOOD",
                  "LOW",
                  "UNPARSED"
                ],
                "default": "GOOD"
              }
            },
            "required": [
              "id",
              "documentVersionId",
              "locator",
              "quotedText"
            ],
            "additionalProperties": false
          }
        },
        "coverageSummary": {
          "type": "object",
          "properties": {
            "totalBlocks": {
              "type": "integer"
            },
            "goodSpans": {
              "type": "integer"
            },
            "lowSpans": {
              "type": "integer"
            },
            "unparsedSpans": {
              "type": "integer"
            }
          },
          "required": [
            "totalBlocks",
            "goodSpans",
            "lowSpans",
            "unparsedSpans"
          ],
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "documentVersionId",
        "format",
        "parseStatus",
        "parserVersion",
        "blocks",
        "spans",
        "coverageSummary"
      ],
      "additionalProperties": false
    },
    "RuleExtractionInput": {
      "type": "object",
      "properties": {
        "projectGlossary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": {
                "type": "string"
              },
              "definition": {
                "type": "string"
              }
            },
            "required": [
              "term",
              "definition"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "documentVersions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ParsedDocumentBundle"
          },
          "minItems": 1
        },
        "images": {
          "type": "array",
