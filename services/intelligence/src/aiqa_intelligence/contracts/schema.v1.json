                    "operator": {
                      "type": "string",
                      "enum": [
                        "gt",
                        "gte",
                        "lt",
                        "lte",
                        "eq",
                        "neq",
                        "in",
                        "between",
                        "contains"
                      ]
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "key"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "documentVersionId": {
                      "$ref": "#/definitions/ParsedDocumentBundle/properties/documentVersionId"
                    },
                    "sourceSpanIds": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/ParsedDocumentBundle/properties/documentVersionId"
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "documentVersionId",
                    "sourceSpanIds"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "conflictsWith": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": [
              "key",
              "statement",
              "classification",
              "action",
              "expectation"
            ],
            "additionalProperties": false
          }
        },
        "clarifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ruleDraftKeys": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "MISSING_INFO",
                  "CONFLICT",
                  "AMBIGUITY"
                ]
              }
            },
            "required": [
              "ruleDraftKeys",
              "question",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "unparsedRanges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "spanId": {
                "$ref": "#/definitions/ParsedDocumentBundle/properties/documentVersionId"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "TABLE_DEGRADED",
                  "LOW_QUALITY_IMAGE",
                  "IRRELEVANT",
                  "OTHER"
                ]
              }
            },
            "required": [
              "spanId",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ruleDrafts",
        "clarifications",
        "unparsedRanges"
      ],
      "additionalProperties": false
    },
    "CaseGenerationInput": {
      "type": "object",
