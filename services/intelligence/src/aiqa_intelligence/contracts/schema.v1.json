              "priority": {
                "type": "string",
                "enum": [
                  "P0",
                  "P1",
                  "P2"
                ],
                "default": "P1"
              },
              "businessFields": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/RuleExtractionOutput/properties/ruleDrafts/items/properties/businessFields/items"
                },
