            "type": "object",
            "properties": {
              "storageKey": {
                "type": "string"
              },
              "spanId": {
                "$ref": "#/definitions/ParsedDocumentBundle/properties/documentVersionId"
              }
            },
            "required": [
              "storageKey",
              "spanId"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "documentVersions",
        "promptVersion"
      ],
      "additionalProperties": false
    },
    "RuleExtractionOutput": {
      "type": "object",
      "properties": {
        "ruleDrafts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^rule-draft-\\d{2,}$"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "classification": {
                "type": "string",
                "enum": [
                  "EXPLICIT",
                  "INFERRED",
                  "UNKNOWN"
                ]
              },
              "role": {
                "type": "string"
              },
              "precondition": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "string"
              },
              "expectation": {
                "type": "string",
                "minLength": 1
              },
              "forbiddenBehaviors": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "priority": {
                "type": "string",
                "enum": [
                  "P0",
                  "P1",
                  "P2"
                ],
                "default": "P1"
              },
              "businessFields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
