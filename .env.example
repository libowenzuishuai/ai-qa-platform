# ============================================================
# AI 测试人员平台 —— 环境变量示例
# 复制为 .env 并填入真实值。示例只含变量名和占位值。
# 真实 API 密钥只通过环境变量或服务端凭据管理注入，
# 不写入代码、提示词、报告或 Git。
# ============================================================

# ---------- 平台数据库（apps/api） ----------
# 本地开发默认端口见 compose.yaml；生产替换为真实连接串
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5435/aiqa?schema=public"

# 会话签名与有效期
SESSION_SECRET="change-me-to-a-long-random-string"
SESSION_TTL_SECONDS="43200"

# API 服务监听
API_HOST="127.0.0.1"
API_PORT="7300"

# 初始管理员种子（db:seed 使用；密码至少 8 位）
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-8-plus"
SEED_LEAD_PASSWORD="change-me-8-plus"
SEED_VIEWER_PASSWORD="change-me-8-plus"

# ---------- Redis / 队列（阶段 1 起 worker 使用） ----------
REDIS_URL="redis://127.0.0.1:6380/0"

# ---------- worker ----------
WORKER_HOST="127.0.0.1"
WORKER_PORT="7200"

# ---------- 运行时模型（阶段 2 起；real 模式必需） ----------
# 文本模型（需求分析/用例设计/失败解释）
AIQA_TEXT_PROVIDER="zhipu"
AIQA_TEXT_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
AIQA_TEXT_MODEL="在此填入账号实际可用的模型名"
AIQA_TEXT_API_KEY=""

# 视觉模型（图片/截图理解；文本模型不能接收图片）
AIQA_VISION_PROVIDER="zhipu"
AIQA_VISION_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
AIQA_VISION_MODEL="在此填入账号实际可用的视觉模型名"
AIQA_VISION_API_KEY=""

# ---------- demo-app（独立待测系统） ----------
DEMO_HOST="127.0.0.1"
DEMO_PORT="7400"
DEMO_DB_PATH="data/demo-app.sqlite"
# 评测夹具令牌：黄金验收与平台数据初始化使用；不要泄露给被测智能体
DEMO_FIXTURE_TOKEN="change-me-fixture-token"
# 缺陷模式（仅评测器使用，逗号分隔：B1,B2,B3,B4；留空 = 健康版本）
DEMO_BUG_MODES=""

# ---------- 部署 webhook（阶段 4） ----------
WEBHOOK_SECRET="change-me-webhook-signing-secret"
