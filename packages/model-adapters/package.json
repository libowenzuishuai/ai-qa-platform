{
  "name": "@ai-qa/model-adapters",
  "version": "0.1.0",
  "private": true,
  "description": "模型适配器：moonshot（Kimi，OpenAI 兼容）真实适配器 + 显式 mock 确定性替身",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "smoke:real": "tsx scripts/smoke-real.mts",
    "mock:register": "node scripts/mock-register.mjs"
  },
  "dependencies": {
    "@ai-qa/contracts": "workspace:*",
    "ajv": "^8.17.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
