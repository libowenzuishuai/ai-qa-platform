{
  "name": "@ai-qa/test-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "受限 TestPlan 执行器：七种动作、角色隔离、导航策略、程序化断言与证据采集",
  "type": "module",
  "main": "./src/index.ts",
